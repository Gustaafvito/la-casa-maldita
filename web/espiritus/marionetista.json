            {
              "nodo": "🕯 HILOS",
              "widget": "select",
              "valor": 2
            },
            {
              "nodo": "🕯 TIPO DE HILO",
              "widget": "type",
              "valor": "depth"
            }
          ]
        },
        {
          "etiqueta": "Pose",
          "icono": "🕺",
          "desc": "Copia solo la postura del cuerpo (esqueleto).",
          "fija": [
            {
              "nodo": "🕯 HILOS",
