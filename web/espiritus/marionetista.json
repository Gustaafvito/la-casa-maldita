              "valor": 1
            },
            {
              "nodo": "🕯 TIPO DE HILO",
              "widget": "type",
              "valor": "canny/lineart/anime_lineart/mlsd"
            }
          ]
        },
        {
          "etiqueta": "Profundidad",
          "icono": "🌫",
          "desc": "Copia qué está cerca y qué lejos. Deja más libertad.",
